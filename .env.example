# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Neon Postgres (Vercel integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Vercel Blob: clips for phrases added from the phrasebook (Vercel integration)
BLOB_READ_WRITE_TOKEN=
# Vercel AI Gateway: writes added phrases. On Vercel the OIDC token is automatic; locally `vercel env pull` adds it
VERCEL_OIDC_TOKEN=
# Optional: gateway model for added phrases (default anthropic/claude-sonnet-5.5)
PHRASE_MODEL=
# Voice for added phrases (server) and for `pnpm audio:gen`. Without it, added phrases use the device voice
ELEVENLABS_API_KEY=
# Optional: base URL for Open Graph links
APP_URL=
